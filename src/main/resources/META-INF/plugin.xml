<idea-plugin>
    <id>com.freemarkerplus</id>
    <name>Freemarker Plus</name>
    <vendor>pengl</vendor>
    <description><![CDATA[
        Syntax highlighting for FreeMarker templates (.ftl, .ftlh, .ftlx) with HTML/CSS/JS support,
        plus code navigation: go to declaration, find usages, structure view, folding, breadcrumbs, rename,
        and HTML/JavaScript navigation (event-handler attributes resolve to script functions, &lt;script src&gt; to files).
    ]]></description>

    <change-notes><![CDATA[
        <b>0.4.0</b>
        <ul>
            <li>Expression support: <code>?builtin</code> functions with arguments (<code>${list?size}</code>, <code>${x?string("a","b")}</code>), chained builtins, and <code>??</code> existence checks — no more red syntax in real-world templates.</li>
            <li>Comparisons: parenthesized <code>&gt;</code>/<code>&lt;</code>/<code>&gt;=</code>/<code>&lt;=</code> inside directives (<code>&lt;#if (a &gt; b)&gt;</code>) and inside interpolations.</li>
            <li>Block-level <code>&lt;#assign x&gt;...&lt;/#assign&gt;</code> parsing and folding; <code>&lt;#escape x as html&gt;</code> now parses.</li>
            <li>Navigation: macro/function parameters resolve as variables inside macro bodies; multi-level <code>&lt;#import "partials/lib.ftl"&gt;</code> paths now resolve.</li>
            <li>Editor: Ctrl+/ block commenting with <code>&lt;#-- --&gt;</code>; folding for <code>compress/noparse/escape</code> and long comments; more precise Find Usages type labels.</li>
        </ul>
    ]]></change-notes>

    <idea-version since-build="262" until-build="262.*"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <lang.parserDefinition language="FreemarkerPlus"
                               implementationClass="com.freemarkerplus.psi.FtlParserDefinition"/>
        <lang.fileViewProviderFactory language="FreemarkerPlus"
                                      implementationClass="com.freemarkerplus.psi.FtlFileViewProviderFactory"/>
        <fileType name="FreeMarker Template"
                  implementationClass="com.freemarkerplus.lang.FreemarkerFileType"
                  fieldName="INSTANCE"
                  language="FreemarkerPlus"
                  extensions="ftl;ftlh;ftlx"/>
        <lang.syntaxHighlighterFactory language="FreemarkerPlus"
                                       implementationClass="com.freemarkerplus.highlighting.FreemarkerSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.freemarkerplus.highlighting.FreemarkerColorSettingsPage"/>
        <psi.referenceContributor language="FreemarkerPlus"
                                  implementation="com.freemarkerplus.reference.FtlReferenceContributor"/>
        <lang.elementManipulator forClass="com.freemarkerplus.psi.FtlStringLiteral"
                                 implementationClass="com.freemarkerplus.reference.FtlStringManipulator"/>
        <lang.elementManipulator forClass="com.freemarkerplus.psi.FtlIdentifier"
                                 implementationClass="com.freemarkerplus.reference.FtlIdentifierManipulator"/>
        <fileBasedIndex implementation="com.freemarkerplus.reference.FtlFileIndex"/>
        <lang.findUsagesProvider language="FreemarkerPlus"
                                 implementationClass="com.freemarkerplus.navigation.FtlFindUsagesProvider"/>
        <findUsagesHandlerFactory implementation="com.freemarkerplus.navigation.FtlFindUsagesHandlerFactory"/>
        <definitionsSearch implementation="com.freemarkerplus.navigation.FtlDefinitionSearcher"/>
        <referencesSearch implementation="com.freemarkerplus.navigation.FtlMethodUsageSearcher"/>
        <lang.psiStructureViewFactory language="FreemarkerPlus"
                                      implementationClass="com.freemarkerplus.navigation.FtlStructureViewBuilderProvider"/>
        <lang.foldingBuilder language="FreemarkerPlus"
                             implementationClass="com.freemarkerplus.navigation.FtlFoldingBuilder"/>
        <breadcrumbsInfoProvider implementation="com.freemarkerplus.navigation.FtlBreadcrumbsInfoProvider"/>
        <renamePsiElementProcessor implementation="com.freemarkerplus.navigation.FtlRenameProcessor"/>
        <lang.namesValidator language="FreemarkerPlus"
                             implementationClass="com.freemarkerplus.navigation.FtlNamesValidator"/>
        <lang.commenter language="FreemarkerPlus"
                        implementationClass="com.freemarkerplus.lang.FreemarkerCommenter"/>
    </extensions>
</idea-plugin>
